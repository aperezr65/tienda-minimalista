<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tienda Minimalista - Gadgets</title>
  <style>
    /* === ESTILO GLOBAL === */
    :root {
      --color-bg: #f6f7fb;
      --color-card: #ffffff;
      --color-primary: #2563eb;
      --color-accent: #10b981;
      --color-text: #1e293b;
      --shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
      --radius: 16px;
      font-family: "Poppins", sans-serif;
    }

    body {
      margin: 0;
      background: var(--color-bg);
      color: var(--color-text);
      scroll-behavior: smooth;
    }

    a { text-decoration: none; color: inherit; }

    /* === ENCABEZADO === */
    header {
      position: sticky;
      top: 0;
      background: var(--color-card);
      box-shadow: var(--shadow);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      border-radius: 0 0 var(--radius) var(--radius);
      z-index: 10;
    }

    header h1 {
      color: var(--color-primary);
      font-weight: 600;
      margin: 0;
    }

    nav a {
      margin-left: 1.5rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    nav a:hover {
      color: var(--color-primary);
    }

    /* === SECCIÓN HERO === */
    #hero {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      padding: 4rem 2rem;
      background: linear-gradient(120deg, #f0f4ff, #ffffff);
      border-bottom: 1px solid #e2e8f0;
    }

    #hero-text {
      flex: 1;
      min-width: 260px;
    }

    #hero-text h2 {
      color: var(--color-primary);
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    #hero-text p {
      max-width: 500px;
      line-height: 1.6;
    }

    #hero img {
      flex: 1;
      min-width: 300px;
      max-width: 450px;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    /* === SECCIONES === */
    section {
      padding: 3rem 2rem;
      max-width: 1200px;
      margin: auto;
    }

    h2 {
      text-align: center;
      color: var(--color-primary);
      margin-bottom: 2rem;
    }

    /* === FORMULARIO DE LOGIN === */
    form {
      background: var(--color-card);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      padding: 2rem;
      max-width: 400px;
      margin: 0 auto;
    }

    label {
      display: block;
      margin-top: 1rem;
      font-weight: 500;
    }

    input {
      width: 100%;
      padding: 0.6rem;
      border: 1px solid #d1d5db;
      border-radius: var(--radius);
      margin-top: 0.3rem;
      font-size: 1rem;
    }

    button {
      background: var(--color-primary);
      color: white;
      border: none;
      padding: 0.7rem 1.2rem;
      border-radius: var(--radius);
      font-size: 1rem;
      cursor: pointer;
      transition: transform 0.15s, background 0.3s;
      margin-top: 1rem;
    }

    button:hover {
      background: #1d4ed8;
      transform: translateY(-2px);
    }

    /* === PRODUCTOS === */
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
    }

    .card {
      background: var(--color-card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.5rem;
      transition: transform 0.2s;
    }

    .card:hover {
      transform: translateY(-4px);
    }

    .card img {
      width: 100%;
      border-radius: var(--radius);
      margin-bottom: 1rem;
    }

    .card h3 {
      margin: 0.5rem 0;
    }

    .price {
      font-weight: 600;
      color: var(--color-accent);
    }

    .btn-add {
      width: 100%;
      background: var(--color-primary);
      color: white;
      padding: 0.7rem;
      border-radius: var(--radius);
      border: none;
      cursor: pointer;
      transition: background 0.3s;
      margin-top: 0.5rem;
    }

    .btn-add:hover {
      background: #1d4ed8;
    }

    /* === CARRITO === */
    #cart {
      background: var(--color-card);
      padding: 2rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      max-width: 600px;
      margin: auto;
    }

    footer {
      text-align: center;
      padding: 2rem;
      color: #6b7280;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <header>
    <h1>GadgetStore</h1>
    <nav>
      <a href="#hero">Inicio</a>
      <a href="#productos">Productos</a>
      <a href="#registro">Registro</a>
      <a href="#carrito">Carrito (<span id="count">0</span>)</a>
    </nav>
  </header>

  <section id="hero">
    <div id="hero-text">
      <h2>Bienvenido a GadgetStore</h2>
      <p>Encuentra los mejores gadgets tecnológicos al mejor precio. Compra rápido, seguro y fácil desde cualquier lugar.</p>
    </div>
    <img src="https://via.placeholder.com/400x260?text=Gadget+Showcase" alt="GadgetStore">
  </section>

  <section id="registro">
    <h2>Registro / Iniciar Sesión</h2>
    <form id="loginForm">
      <label>Usuario:
        <input type="text" id="user" required>
      </label>
      <label>Contraseña:
        <input type="password" id="pass" required>
      </label>
      <button type="submit">Iniciar Sesión</button>
      <p style="font-size:0.9rem;" id="msg"></p>
    </form>
  </section>

  <section id="productos">
    <h2>Productos Destacados</h2>
    <div class="products" id="productList"></div>
  </section>

  <section id="carrito">
    <h2>Carrito de Compras</h2>
    <div id="cart">El carrito está vacío.</div>
  </section>

  <footer>
    Proyecto Universitario – Tienda Minimalista en HTML, CSS y JS
  </footer>

  <script>
    const productos = [
      {id:1, nombre:"Auriculares Bluetooth", precio:49.99, img:"https://via.placeholder.com/300x200?text=Auriculares"},
      {id:2, nombre:"Teclado Mecánico", precio:89.50, img:"https://via.placeholder.com/300x200?text=Teclado"},
      {id:3, nombre:"Mouse Ergonómico", precio:29.99, img:"https://via.placeholder.com/300x200?text=Mouse"},
      {id:4, nombre:"Cargador 65W", precio:24.75, img:"https://via.placeholder.com/300x200?text=Cargador"},
      {id:5, nombre:"Mochila Laptop", precio:59.00, img:"https://via.placeholder.com/300x200?text=Mochila"}
    ];

    let carrito = [];
    let logeado = false;

    const lista = document.getElementById("productList");
    const cartDiv = document.getElementById("cart");
    const count = document.getElementById("count");
    const msg = document.getElementById("msg");

    function renderProductos() {
      lista.innerHTML = "";
      productos.forEach(p => {
        const div = document.createElement("div");
        div.className = "card";
        div.innerHTML = `
          <img src="${p.img}" alt="${p.nombre}">
          <h3>${p.nombre}</h3>
          <p class="price">Q${p.precio.toFixed(2)}</p>
          <button class="btn-add" data-id="${p.id}" ${!logeado ? "disabled" : ""}>Agregar al carrito</button>
        `;
        lista.appendChild(div);
      });
    }

    document.addEventListener("click", e => {
      if (e.target.matches(".btn-add")) {
        const id = +e.target.dataset.id;
        const prod = productos.find(p => p.id === id);
        carrito.push(prod);
        updateCarrito();
        alert(`${prod.nombre} agregado al carrito.`);
      }
    });

    function updateCarrito() {
      count.textContent = carrito.length;
      if (carrito.length === 0) {
        cartDiv.innerHTML = "El carrito está vacío.";
      } else {
        cartDiv.innerHTML = carrito.map(p => `<p>${p.nombre} - Q${p.precio.toFixed(2)}</p>`).join("");
        const total = carrito.reduce((sum, p) => sum + p.precio, 0);
        cartDiv.innerHTML += `<hr><strong>Total: Q${total.toFixed(2)}</strong>`;
      }
    }

    document.getElementById("loginForm").addEventListener("submit", e => {
      e.preventDefault();
      const user = document.getElementById("user").value;
      const pass = document.getElementById("pass").value;
      if (user === "alumno" && pass === "2025") {
        logeado = true;
        msg.textContent = "Inicio de sesión exitoso. Ahora puedes comprar.";
        msg.style.color = "green";
      } else {
        msg.textContent = "Usuario o contraseña incorrectos.";
        msg.style.color = "red";
      }
      renderProductos();
    });

    renderProductos();
  </script>
</body>
</html>
